# ==============================================================================
# SCAMSHIELD AI - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server Port (Default: 3001)
PORT=3001

# ------------------------------------------------------------------------------
# 1. THREAT INTELLIGENCE APIS (Optional - System works with live socket/DNS/RDAP without them)
# ------------------------------------------------------------------------------
# VirusTotal API Key (Free tier at https://www.virustotal.com/gui/join-us)
VIRUSTOTAL_API_KEY=

# Google Safe Browsing API v4 Key (Free tier via Google Cloud Console)
GOOGLE_SAFE_BROWSING_API_KEY=

# ------------------------------------------------------------------------------
# 2. GENERATIVE AI & NLP DECEPTION ANALYSIS (Optional)
# ------------------------------------------------------------------------------
# Google Gemini 1.5 Flash API Key (Free at https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# OpenAI API Key (Alternative to Gemini at https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# ------------------------------------------------------------------------------
# 3. SUPABASE DATABASE (Optional - App runs in local in-memory mode if unset)
# ------------------------------------------------------------------------------
# Supabase Project URL (e.g. https://your-project.supabase.co)
SUPABASE_URL=

# Supabase Service Role Key (Project Settings -> API -> service_role secret)
SUPABASE_SERVICE_ROLE_KEY=

# Supabase Public Anon Key (Optional for frontend direct reads)
SUPABASE_ANON_KEY=

# ------------------------------------------------------------------------------
# 4. DEPLOYMENT & CRON SECURITY
# ------------------------------------------------------------------------------
# Secret token to protect Vercel cron endpoints (/api/cron/update-threat-feeds)
CRON_SECRET=scamshield_secure_cron_secret_token

